{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "docs",
  "routes": [
    {
      "src": "/flutter_service_worker.js",
      "headers": {
        "Cache-Control": "no-cache"
      },
      "dest": "/flutter_service_worker.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
